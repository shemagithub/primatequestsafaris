NODE_ENV=production

# Public website (frontend). This Node app stays on backend.primatequestsafaris.com
SITE_URL=https://primatequestsafaris.com
FRONTEND_ORIGIN=https://primatequestsafaris.com,https://www.primatequestsafaris.com

# Use the MySQL database created in cPanel
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password
DB_NAME=your_cpanel_db_name

# Long random string — never leave the example value on the live server
JWT_SECRET=change-this-to-a-long-random-secret

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@primatesquest.com
ADMIN_PASSWORD=Admin@12345

SMTP_HOST=primatequestsafaris.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@primatequestsafaris.com
SMTP_PASS=
MAIL_FROM_NAME=Primate Quest Safaris
MAIL_NOTIFY=info@primatequestsafaris.com
